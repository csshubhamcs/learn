<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
      Every profile except local: structured JSON on stdout, for log aggregators.
      LogstashEncoder serializes the entire current MDC map as top-level JSON fields with no
      configuration, so traceId/spanId appear automatically once Micrometer Tracing populates
      them.
    -->
    <springProfile name="!local">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>
        <root level="${LOG_LEVEL:-INFO}">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <!-- local: human-readable console output. "%mdc" prints the whole MDC map when present. -->
    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss} %-5level [%mdc] %logger{20} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
